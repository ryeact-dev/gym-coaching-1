---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Cta from '../../components/Cta.astro';
import { chapters } from '../../data/chapters.js';
---
<Layout title="All chapters · Daniel Shaw">
  <Header />
  <main>
    <section class="page-head">
      <div class="wrap">
        <span class="mono y reveal">All chapters</span>
        <h1 class="display reveal" style="--d:.08s">Every chapter<br />so far.</h1>
        <p class="reveal" style="--d:.16s">Four clients, each one a twelve-week chapter. Shared with their written permission.</p>
      </div>
    </section>
    <div class="light">
      <div class="wrap cards">
        {chapters.map((c, i) => (
          <a class="card-ch reveal" style={`--d:${(i % 2) * 0.12}s`} href={`/chapters/${c.slug}`}>
            <div class="thumb" style={`background-image:url(${c.img});background-color:${c.bg}`}>
              <div class="ov"><b class="display">{c.big}</b><span class="highlight">{c.tag}</span></div>
            </div>
            <div class="meta"><h3>{c.name}, {c.age} · {c.role}</h3><span class="mono dim">Chapter {c.n}</span></div>
            <p>“{c.quote}”</p>
          </a>
        ))}
      </div>
      <Cta />
    </div>
  </main>
  <Footer />
</Layout>
